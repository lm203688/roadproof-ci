{
  "expo": {
    "name": "RoadProof",
    "slug": "roadproof",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "description": "A 49 CFR 396.11 walk-around record for one truck. One purchase, no account, no ads, no subscription.",
    "assetBundlePatterns": ["**/*"],
    "icon": "./assets/icon.png",
    "ios": {
      "bundleIdentifier": "com.lixing.roadproof",
      "icon": "./assets/icon.png",
      "supportsTablet": true,
      "deploymentTarget": "16.4",
      "buildNumber": "1",
      "config": { "usesNonExemptEncryption": false },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIRequiredDeviceCapabilities": ["arm64"]
      },
      "privacyManifests": {
        "NSPrivacyTracking": false,
        "NSPrivacyTrackingDomains": [],
        "NSPrivacyCollectedDataTypes": [],
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": ["CA92.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": ["0A2A.1", "3B52.1", "C617.1"]
          }
        ]
      }
    },
    "plugins": [
      ["expo-build-properties", { "ios": { "deploymentTarget": "16.4" } }],
      "./plugins/withUIScene.cjs",
      "./plugins/withAppIntents.cjs",
      "./plugins/withWidget.cjs",
      "./plugins/withPodTargetFloor.cjs"
    ],
    "owner": "lm203688"
  }
}